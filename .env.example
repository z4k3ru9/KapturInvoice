APP_NAME=KapturInvoice
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# sqlite by default for zero-setup local dev; switch to mysql (matching the
# legacy InvoiceNinja MariaDB dump this imports from) for anything beyond that.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=kapturinvoice
# DB_USERNAME=root
# DB_PASSWORD=

# Only needed to run `import:invoiceninja-v4`/`import:invoiceninja-v5` —
# a separate read-only MySQL/MariaDB connection per restored legacy dump,
# never the app's own database. See docs/data-import.md.
# LEGACY_V4_DB_HOST=127.0.0.1
# LEGACY_V4_DB_DATABASE=legacy_v4
# LEGACY_V4_DB_USERNAME=root
# LEGACY_V4_DB_PASSWORD=
# LEGACY_V5_DB_HOST=127.0.0.1
# LEGACY_V5_DB_DATABASE=legacy_v5
# LEGACY_V5_DB_USERNAME=root
# LEGACY_V5_DB_PASSWORD=
# Company A's own InvoiceNinja install is v5 too (upgraded from v4) — a
# second, separate v5 connection, since it's a different database/company
# than LEGACY_V5_DB_* above (Company B's).
# LEGACY_V5_COMPANY_A_DB_HOST=127.0.0.1
# LEGACY_V5_COMPANY_A_DB_DATABASE=legacy_v5_company_a
# LEGACY_V5_COMPANY_A_DB_USERNAME=root
# LEGACY_V5_COMPANY_A_DB_PASSWORD=

# Only needed once, to bootstrap a brand-new production database over HTTP
# when the host gives you cron but no Terminal/SSH — see
# config/deploy.php's own docblock and README.md's "Deploying to cPanel"
# section. Leave unset normally; the /deploy/* routes 404 until this is
# set, and should go back to unset again once you're done with them.
# DEPLOY_MIGRATE_TOKEN=
# DEPLOY_ADMIN_NAME="Owner"
# DEPLOY_ADMIN_EMAIL=
# DEPLOY_ADMIN_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local/dev default. To send real invoice/quote/quotation emails (with
# their PDF attached — see App\Services\BillingMailer /
# App\Services\Sales\QuotationMailer) through a Gmail account, switch
# MAIL_MAILER to "smtp" and fill in the Gmail block below — no code
# changes needed, config/mail.php's smtp mailer reads these env vars
# directly and Gmail's SMTP server is standard SMTP+STARTTLS.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Gmail SMTP — uncomment and fill in to send through a Gmail/Google
# Workspace account instead of the local/dev mailer above:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=youraddress@gmail.com
#   MAIL_PASSWORD=your-16-character-app-password
#   MAIL_FROM_ADDRESS=youraddress@gmail.com
#   MAIL_FROM_NAME="${APP_NAME}"
# MAIL_SCHEME can stay null — Symfony Mailer negotiates STARTTLS
# automatically on port 587. Gmail REQUIRES a 16-character App Password
# (Google Account > Security > 2-Step Verification > App passwords) —
# it will reject the account's normal login password for SMTP once
# 2-Step Verification is on, and Google no longer allows enabling
# "less secure app access" to work around this.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
