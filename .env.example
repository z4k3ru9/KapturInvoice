APP_NAME=KapturInvoice
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# sqlite by default for zero-setup local dev; switch to mysql (matching the
# legacy InvoiceNinja MariaDB dump this imports from) for anything beyond that.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=kapturinvoice
# DB_USERNAME=root
# DB_PASSWORD=

# Only needed to run `import:invoiceninja-v4`/`import:invoiceninja-v5` —
# a separate read-only MySQL/MariaDB connection per restored legacy dump,
# never the app's own database. See docs/data-import.md.
# LEGACY_V4_DB_HOST=127.0.0.1
# LEGACY_V4_DB_DATABASE=legacy_v4
# LEGACY_V4_DB_USERNAME=root
# LEGACY_V4_DB_PASSWORD=
# LEGACY_V5_DB_HOST=127.0.0.1
# LEGACY_V5_DB_DATABASE=legacy_v5
# LEGACY_V5_DB_USERNAME=root
# LEGACY_V5_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
