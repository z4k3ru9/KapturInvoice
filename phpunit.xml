<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            The dompdf-heavy Feature tests (invoice/quotation/vendor-bill/etc.
            PDF rendering, multi-page footer tests) can exceed a CLI's
            default 128M memory_limit partway through a full run — this
            manifests as "Fatal error: Premature end of PHP process" from
            whichever process actually executes PHPUnit. A `-d
            memory_limit=...` flag on the invoking `php` command does NOT
            reliably fix this: `php artisan test` runs PHPUnit in a
            genuinely separate child process (via Symfony Process, for
            streamed/colored output), which starts fresh with the system
            php.ini rather than inheriting the parent process's `-d`
            overrides. Setting it here instead applies via ini_set() during
            PHPUnit's own bootstrap, so it takes effect no matter how
            PHPUnit ends up invoked (`vendor/bin/phpunit`, `php artisan
            test`, an IDE runner, or CI).
        -->
        <ini name="memory_limit" value="1024M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
